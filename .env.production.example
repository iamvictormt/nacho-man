# Copie para .env.production na VPS e preencha com valores reais.

APP_PORT=3000
POSTGRES_DB=nachoman
POSTGRES_USER=nachoman
POSTGRES_PASSWORD=troque-por-uma-senha-forte

DATABASE_URL=postgresql://nachoman:troque-por-uma-senha-forte@db:5432/nachoman?schema=public
PRISMA_CONNECTION_LIMIT=5
PRISMA_POOL_TIMEOUT=20

SESSION_SECRET=gere-uma-chave-longa-com-openssl-rand-base64-48
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=seu-place-id

CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret

SAIPOS_DATA_API_TOKEN=Bearer seu-token-saipos
SAIPOS_SYNC_SECRET=gere-um-token-para-o-endpoint-de-sync

SMTP_HOST=smtp.exemplo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp
SMTP_FROM=Nacho Factory <adm@seudominio.com.br>
