generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_MASTER
  ADMIN
  FRANCHISEE
  USER
}

enum ProductUnit {
  KG
  UND
  CX
}

enum ProductAudience {
  FRANCHISEE
  PUBLIC
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionScope {
  PRODUCT
  CATEGORY
  ORDER
}

enum OrderStatus {
  DRAFT
  AWAITING_SERVICE
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  PICKING
  INVOICED
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
}

enum OrderFulfillmentMethod {
  FACTORY_PICKUP
  SHIP_BY_CARRIER
}

enum MarketplaceCartItemType {
  PRODUCT
  COMBO
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String
  mustChangePassword   Boolean               @default(false)
  role                 UserRole
  canAccessIndicators  Boolean               @default(false)
  active               Boolean               @default(true)
  franchiseId          String?               @unique
  franchise            Franchise?            @relation(fields: [franchiseId], references: [id])
  businessProfile      BusinessProfile?
  orders               Order[]
  marketplaceCartItems MarketplaceCartItem[]
  passwordResetCodes   PasswordResetCode[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, code])
  @@index([expiresAt])
}

model SiteSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaiposSale {
  id                      String                    @id @default(cuid())
  idStore                 Int
  idSale                  BigInt
  idSaleType              Int
  createdAtSaipos         DateTime
  updatedAtSaipos         DateTime?
  shiftDate               DateTime?
  canceled                Boolean                   @default(false)
  totalAmountInCents      Int                       @default(0)
  totalDiscountInCents    Int                       @default(0)
  totalIncreaseInCents    Int                       @default(0)
  totalAmountItemsInCents Int                       @default(0)
  paymentMethod           String?
  partnerName             String?
  partnerStatus           String?
  raw                     Json
  items                   SaiposSaleItem[]
  payments                SaiposSalePayment[]
  statusHistories         SaiposSaleStatusHistory[]
  syncedAt                DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([idStore, idSale])
  @@index([createdAtSaipos])
  @@index([shiftDate])
  @@index([idStore, createdAtSaipos])
}

model SaiposSalePayment {
  id                   String     @id @default(cuid())
  idStore              Int
  idSale               BigInt
  paymentIndex         Int
  paymentAmountInCents Int        @default(0)
  paymentType          String?
  changeForInCents     Int        @default(0)
  createdAtSaipos      DateTime?
  raw                  Json
  sale                 SaiposSale @relation(fields: [idStore, idSale], references: [idStore, idSale], onDelete: Cascade)
  syncedAt             DateTime   @default(now())
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@unique([idStore, idSale, paymentIndex])
  @@index([idStore, idSale])
  @@index([paymentType])
  @@index([createdAtSaipos])
}

model SaiposSaleItem {
  id               String     @id @default(cuid())
  idStore          Int
  idSale           BigInt
  idSaleItem       BigInt
  idStoreItem      Int?
  idStoreVariation Int?
  descSaleItem     String
  quantity         Float      @default(0)
  unitPriceInCents Int        @default(0)
  deleted          Boolean    @default(false)
  status           Int?
  createdAtSaipos  DateTime?
  updatedAtSaipos  DateTime?
  doneAt           DateTime?
  choices          Json?
  raw              Json
  sale             SaiposSale @relation(fields: [idStore, idSale], references: [idStore, idSale], onDelete: Cascade)
  syncedAt         DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([idStore, idSaleItem])
  @@index([idStore, idSale])
  @@index([idStoreItem])
  @@index([createdAtSaipos])
}

model SaiposSaleStatusHistory {
  id                    String     @id @default(cuid())
  idStore               Int
  idSale                BigInt
  idSaleStatusHistory   BigInt
  statusOrder           Int?
  statusDescription     String?
  durationTimeSeconds   Int?
  cancellationReason    String?
  userId                Int?
  userName              String?
  userEmail             String?
  userType              Int?
  authorizedByUserId    Int?
  authorizedByUserName  String?
  authorizedByUserEmail String?
  authorizedByUserType  Int?
  createdAtSaipos       DateTime?
  raw                   Json
  sale                  SaiposSale @relation(fields: [idStore, idSale], references: [idStore, idSale], onDelete: Cascade)
  syncedAt              DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([idStore, idSaleStatusHistory])
  @@index([idStore, idSale])
  @@index([statusDescription])
  @@index([createdAtSaipos])
}

model SaiposProductReference {
  id                String    @id @default(cuid())
  productKey        String    @unique
  idStore           Int
  idStoreItem       Int?
  idStoreVariation  Int?
  integrationCode   String?
  name              String
  firstSeenAtSaipos DateTime?
  lastSeenAtSaipos  DateTime?
  lastSoldAtSaipos  DateTime?
  raw               Json?
  syncedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([idStore])
  @@index([idStore, idStoreItem])
  @@index([integrationCode])
  @@index([name])
}

model SaiposStockMovement {
  id                        String    @id @default(cuid())
  idStore                   Int
  idStoreIngredMovement     BigInt
  idStoreIngredient         BigInt?
  idMovementType            Int?
  dateMovement              DateTime?
  createdAtSaipos           DateTime?
  quantityText              String?
  quantityNumber            Float?
  quantityEntryText         String?
  unitCostInCents           Int       @default(0)
  movementCostInCents       Int       @default(0)
  saleId                    BigInt?
  saleNumber                Int?
  notes                     String?
  ingredientName            String?
  ingredientGroupId         BigInt?
  ingredientGroupName       String?
  currentInventory          Float?
  minimumStock              Float?
  averageCostInCents        Int       @default(0)
  averageCostMethod         String?
  controlInventory          Boolean   @default(false)
  includeInCmvCalc          Boolean   @default(false)
  unitMeasure               String?
  identificationNfItem      String?
  identificationNfItemId    BigInt?
  raw                       Json
  syncedAt                  DateTime  @default(now())
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([idStore, idStoreIngredMovement])
  @@index([idStore])
  @@index([dateMovement])
  @@index([idStoreIngredient])
  @@index([saleId])
  @@index([includeInCmvCalc])
}

model SaiposFinancialTransaction {
  id                           String    @id @default(cuid())
  idStore                      Int
  idStoreFinTransaction        BigInt
  amountInCents                Int       @default(0)
  paid                         Boolean   @default(false)
  recurring                    Boolean   @default(false)
  conciliated                  Boolean   @default(false)
  installment                  Int?
  totalInstallments            Int?
  providerTradeName            String?
  bankAccountDescription       String?
  paymentMethodDescription     String?
  transactionDescription       String?
  financialCategoryDescription String?
  date                         DateTime?
  paymentDate                  DateTime?
  issuanceDate                 DateTime?
  createdAtSaipos              DateTime?
  updatedAtSaipos              DateTime?
  children                     Json?
  raw                          Json
  syncedAt                     DateTime  @default(now())
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([idStore, idStoreFinTransaction])
  @@index([idStore])
  @@index([date])
  @@index([paymentDate])
  @@index([paid])
  @@index([financialCategoryDescription])
}

model SaiposSyncRun {
  id              String    @id @default(cuid())
  status          String
  dateColumn      String
  periodStart     DateTime
  periodEnd       DateTime
  recordsFetched  Int       @default(0)
  recordsUpserted Int       @default(0)
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
}

model Franchise {
  id            String    @id @default(cuid())
  tradeName     String
  legalName     String?
  document      String?   @unique
  whatsapp      String?
  active        Boolean   @default(true)
  priceDiscount Int       @default(0)
  user          User?
  orders        Order[]
  addresses     Address[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model BusinessProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName String
  tradeName String
  document  String   @unique
  email     String
  phone     String?
  city      String
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([document])
}

model Address {
  id          String    @id @default(cuid())
  label       String
  street      String
  number      String
  complement  String?
  district    String
  city        String
  state       String
  postalCode  String
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([franchiseId])
}

model Category {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  products   Product[]
  promotions Promotion[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Product {
  id                      String                @id @default(cuid())
  name                    String
  slug                    String                @unique
  description             String?
  features                String?
  applications            String?
  storageInfo             String?
  usageInfo               String?
  yieldInfo               String?
  image                   String?
  sku                     String?               @unique
  priceInCents            Int
  unit                    ProductUnit
  audience                ProductAudience       @default(FRANCHISEE)
  packageLabel            String
  minimumQuantity         Int                   @default(1)
  stockQuantity           Int?
  active                  Boolean               @default(true)
  featured                Boolean               @default(false)
  paymentDiscountEligible Boolean               @default(true)
  categoryId              String
  category                Category              @relation(fields: [categoryId], references: [id])
  comboItems              ComboOption[]
  orderItems              OrderItem[]
  marketplaceCartItems    MarketplaceCartItem[]
  promotions              Promotion[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([categoryId])
  @@index([active, featured])
  @@index([audience, active, featured])
}

model Combo {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  description          String?
  image                String?
  priceInCents         Int
  audience             ProductAudience       @default(FRANCHISEE)
  totalUnits           Int                   @default(1)
  active               Boolean               @default(true)
  startsAt             DateTime?
  endsAt               DateTime?
  options              ComboOption[]
  orderItems           OrderItem[]
  marketplaceCartItems MarketplaceCartItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([audience, active])
}

model MarketplaceCartItem {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey         String
  type            MarketplaceCartItemType
  productId       String?
  product         Product?                @relation(fields: [productId], references: [id], onDelete: Cascade)
  comboId         String?
  combo           Combo?                  @relation(fields: [comboId], references: [id], onDelete: Cascade)
  selectionKey    String?
  selectedOptions Json?
  quantity        Int
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([userId, itemKey])
  @@index([userId, updatedAt])
  @@index([productId])
  @@index([comboId])
}

model ComboOption {
  id        String  @id @default(cuid())
  comboId   String
  productId String
  quantity  Int     @default(1)
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([comboId, productId])
  @@index([productId])
  @@map("ComboItem")
}

model Promotion {
  id              String         @id @default(cuid())
  name            String
  description     String?
  type            DiscountType
  value           Int
  scope           PromotionScope
  productId       String?
  categoryId      String?
  minimumQuantity Int?
  minimumInCents  Int?
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean        @default(true)
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([active, startsAt, endsAt])
  @@index([productId])
  @@index([categoryId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  type           DiscountType
  value          Int
  minimumInCents Int?
  maximumUses    Int?
  uses           Int          @default(0)
  startsAt       DateTime
  endsAt         DateTime
  active         Boolean      @default(true)
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([active, startsAt, endsAt])
}

model Order {
  id                       String                 @id @default(cuid())
  number                   Int                    @unique @default(autoincrement())
  franchiseId              String?
  franchise                Franchise?             @relation(fields: [franchiseId], references: [id])
  userId                   String?
  user                     User?                  @relation(fields: [userId], references: [id])
  status                   OrderStatus            @default(AWAITING_SERVICE)
  paymentMethod            PaymentMethod
  fulfillmentMethod        OrderFulfillmentMethod @default(SHIP_BY_CARRIER)
  scheduledPickupAt        DateTime?
  couponId                 String?
  coupon                   Coupon?                @relation(fields: [couponId], references: [id])
  subtotalInCents          Int
  promotionDiscountInCents Int                    @default(0)
  couponDiscountInCents    Int                    @default(0)
  pixDiscountInCents       Int                    @default(0)
  shippingInCents          Int                    @default(0)
  totalInCents             Int
  notes                    String?
  deliveryAddress          Json?
  items                    OrderItem[]
  statusHistory            OrderStatusHistory[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([franchiseId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  comboId          String?
  combo            Combo?   @relation(fields: [comboId], references: [id])
  name             String
  sku              String?
  unit             String
  quantity         Int
  unitPriceInCents Int
  totalInCents     Int
  selectedOptions  Json?

  @@index([orderId])
  @@index([productId])
  @@index([comboId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}
